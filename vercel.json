{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/web/favicon.svg"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/styles.css",
      "destination": "/web/styles.css"
    },
    {
      "source": "/downloads/:path*",
      "destination": "/web/downloads/:path*"
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,reports/**,graphify-out/**,docs/ai/vault_bootstrap/**,reference/**,web/**,data/generated/full_scan/**,data/generated/production_state/**,data/generated/intelligence/codex_queue/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
